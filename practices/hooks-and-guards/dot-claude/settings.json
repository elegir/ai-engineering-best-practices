{
  "_comment": "Merge into <repo>/.claude/settings.json. <<PYTHON>> = the interpreter name on this machine (python3 on macOS/Linux/Git Bash; python or py -3 on Windows). The '|| exit 2' makes a missing interpreter BLOCK instead of pass. Layer 1 is the native deny list; layer 2 is guard.py reading .claude/hooks.json.",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit -m*)",
      "Bash(git worktree list*)",
      "Bash(<<TEST_COMMAND, e.g. pytest*>>)",
      "Bash(<<LINT_COMMAND, e.g. ruff*>>)",
      "Bash(ls*)",
      "Bash(cat *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Edit(.env*)",
      "Write(.env*)",
      "Edit(.claude/**)",
      "Write(.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "<<PYTHON>> .claude/hooks/guard.py pre-edit || exit 2" } ] },
      { "matcher": "Bash",                 "hooks": [ { "type": "command", "command": "<<PYTHON>> .claude/hooks/guard.py pre-bash || exit 2" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "<<PYTHON>> .claude/hooks/guard.py post-edit || exit 2" } ] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "<<PYTHON>> .claude/hooks/guard.py stop || exit 2" } ] }
    ]
  }
}
